FOR THE .env.local FILE FOR EVERY MEMBER:
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only. Used by the recruiter candidate comparison (Jev via Vercel AI Gateway).
# Never prefix with NEXT_PUBLIC_ and never commit a real key.
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key

# Server-only. Used by the AI job recommendation summaries (Groq, free tier).
# Never prefix with NEXT_PUBLIC_ and never commit a real key.
GROQ_API_KEY=your_groq_api_key
# Optional: override the summary model (default: openai/gpt-oss-20b).
# RECOMMENDATION_SUMMARY_MODEL=
